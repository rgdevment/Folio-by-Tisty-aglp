{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "tisty-diagrams/*": ["../tisty/packages/tisty-diagrams/src/*"],
      "tisty-editor/*": ["../tisty/packages/tisty-editor/src/*"]
    }
  },
  "include": ["src", "tests", "wasm"]
}
